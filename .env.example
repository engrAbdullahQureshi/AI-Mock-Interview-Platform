# ===== AI Mock Interview Platform — environment =====
# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# --- Required for AI features (resume parsing, questions, scoring) ---
# Free key from https://console.groq.com
GROQ_API_KEY=

# --- Security: change this to any random 32+ char string ---
SECRET_KEY=change-me-to-a-random-32-plus-character-secret

# --- Database (OPTIONAL) ---
# Leave MONGODB_URL empty to use the built-in in-memory store (great for demos).
# To persist data, set a MongoDB Atlas connection string.
MONGODB_URL=
MONGODB_DB_NAME=ai_interview_db

# --- App ---
DEBUG=True
API_VERSION=v1

# --- Redis (OPTIONAL — app degrades gracefully if absent) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
